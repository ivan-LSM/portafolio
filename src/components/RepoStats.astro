---
import { getRepoStats, LANG_COLORS } from '../data/github';
import type { Lang } from '../i18n/utils';

interface Props {
  /** URL del repo en GitHub (campo `repo` del proyecto). */
  repo?: string;
  lang: Lang;
}
const { repo, lang } = Astro.props;
const stats = await getRepoStats(repo);

let updated = '';
if (stats && stats.pushedAt) {
  const days = Math.max(0, Math.floor((Date.now() - new Date(stats.pushedAt).getTime()) / 86_400_000));
  updated =
    lang === 'es'
      ? days === 0
        ? 'Actualizado hoy'
        : `Actualizado hace ${days} ${days === 1 ? 'día' : 'días'}`
      : days === 0
        ? 'Updated today'
        : `Updated ${days} ${days === 1 ? 'day' : 'days'} ago`;
}
const fallback = ['#73eff7', '#41a6f6', '#a7f070', '#ffcd75', '#b13e53'];
const color = (name: string, i: number) => LANG_COLORS[name] ?? fallback[i % fallback.length];
---

{
  stats && (
    <div class="repo-stats" style="display:flex;flex-direction:column;gap:0.5rem;font-family:'Pixelify Sans',monospace;font-size:0.85rem">
      <div style="display:flex;flex-wrap:wrap;gap:0.25rem 1rem;align-items:center">
        <span style="display:inline-flex;align-items:center;gap:0.35rem" title="Stars">
          <svg width="16" height="16" viewBox="0 0 8 8" shape-rendering="crispEdges" fill="#ffcd75" aria-hidden="true">
            <rect x="3" y="0" width="2" height="2" />
            <rect x="0" y="2" width="8" height="2" />
            <rect x="1" y="4" width="6" height="2" />
            <rect x="1" y="6" width="2" height="2" />
            <rect x="5" y="6" width="2" height="2" />
          </svg>
          <span>{stats.stars}</span>
        </span>
        <span>Forks: {stats.forks}</span>
        {updated && <span style="color:var(--muted)">{updated}</span>}
      </div>
      {stats.languages.length > 0 && (
        <>
          <div
            role="img"
            aria-label={stats.languages.map((l) => `${l.name} ${l.percent}%`).join(', ')}
            style="display:flex;height:8px;border:2px solid var(--border);overflow:hidden"
          >
            {stats.languages.map((l, i) => (
              <span style={`width:${l.percent}%;background:${color(l.name, i)}`} />
            ))}
          </div>
          <ul style="display:flex;flex-wrap:wrap;gap:0.25rem 0.75rem;margin:0;padding:0;list-style:none;color:var(--muted)">
            {stats.languages.map((l, i) => (
              <li style="display:inline-flex;align-items:center;gap:0.3rem">
                <span style={`width:8px;height:8px;background:${color(l.name, i)}`} />
                {l.name} {l.percent}%
              </li>
            ))}
          </ul>
        </>
      )}
    </div>
  )
}
