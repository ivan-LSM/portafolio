---
import { CV_PATH, GITHUB_URL, SHOW_CV } from '../config';
import { localePath, t, withBase, type Lang } from '../i18n/utils';
import PixelButton from './PixelButton.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const home = localePath(lang);
---

<section aria-labelledby="hero-title" class="py-16 sm:py-24">
  <div class="container-px grid items-center gap-12 md:grid-cols-[1fr_auto]">
    <div>
      <p class="m-0 mb-3 font-pixel text-xl text-[var(--cyan)]">{t(lang, 'hero.greeting')}</p>
      <h1 id="hero-title" class="m-0 text-5xl sm:text-7xl">
        Iván Salas<span class="cursor" aria-hidden="true"></span>
      </h1>
      <p class="m-0 mt-4 font-pixel text-2xl text-[var(--yellow)] sm:text-3xl">{t(lang, 'hero.role')}</p>
      <p class="mt-6 max-w-xl text-lg text-[var(--muted)]">{t(lang, 'hero.pitch')}</p>
      <div class="mt-8 flex flex-wrap gap-4">
        <PixelButton href={`${home}#projects`} lang={lang} variant="primary">{t(lang, 'hero.cta.projects')}</PixelButton>
        <PixelButton href={`${home}#contact`} lang={lang}>{t(lang, 'hero.cta.contact')}</PixelButton>
        <PixelButton href={GITHUB_URL} lang={lang} external>{t(lang, 'hero.github')}</PixelButton>
        {SHOW_CV && <PixelButton href={withBase(CV_PATH)} lang={lang}>{t(lang, 'hero.cta.cv')}</PixelButton>}
      </div>
    </div>

    <!-- Monitor pixel-art decorativo -->
    <svg
      class="px bob mx-auto hidden w-56 md:block"
      viewBox="0 0 16 14"
      shape-rendering="crispEdges"
      aria-hidden="true"
    >
      <rect x="1" y="0" width="14" height="10" fill="#566c86"></rect>
      <rect x="2" y="1" width="12" height="8" fill="#1a1c2c"></rect>
      <rect x="3" y="2" width="3" height="1" fill="#a7f070"></rect>
      <rect x="3" y="4" width="6" height="1" fill="#41a6f6"></rect>
      <rect x="5" y="6" width="4" height="1" fill="#ffcd75"></rect>
      <rect x="10" y="6" width="1" height="2" fill="#73eff7"></rect>
      <rect x="6" y="10" width="4" height="2" fill="#94b0c2"></rect>
      <rect x="4" y="12" width="8" height="1" fill="#566c86"></rect>
    </svg>
  </div>
</section>
